#!/usr/bin/env python3
"""
Legami Adventskalender "Dream Peaks" - Verfuegbarkeits-Waechter

Prueft die Produktseite und benachrichtigt (ntfy-Push und/oder E-Mail),
sobald sich der Verfuegbarkeitsstatus aendert - vor allem, wenn der
Kalender wieder bestellbar ist.

Aufruf:
  python legami_watch.py              # normaler Lauf (fuer Cron / GitHub Actions)
  python legami_watch.py --debug      # zeigt, welche Signale erkannt wurden
  python legami_watch.py --test-notify  # schickt eine Test-Benachrichtigung

Konfiguration ueber Umgebungsvariablen (alle optional ausser einem Kanal):
  NTFY_TOPIC      Topic fuer ntfy.sh (Push aufs Handy, ohne Account)
  NTFY_SERVER     Standard: https://ntfy.sh
  NTFY_TOKEN      Optional: Bearer-Token fuer ntfy/selbst gehostete Server
  NTFY_USERNAME, NTFY_PASSWORD  Optional: Basic-Auth fuer ntfy
  SMTP_HOST, SMTP_PORT (465), SMTP_USER, SMTP_PASS, MAIL_TO, MAIL_FROM
  WATCH_URL       Standard: die Dream-Peaks-Seite auf legami.com
  STATE_FILE      Standard: .legami_state.json
"""
import argparse
import json
import os
import re
import smtplib
import sys
from email.message import EmailMessage
from pathlib import Path

import requests

WATCH_URL_DEFAULT = os.getenv(
    "WATCH_URL",
    "https://www.legami.com/de-de/adventskalender-dream-peaks-VADC0004.html",
)
STATE_FILE_DEFAULT = Path(os.getenv("STATE_FILE", ".legami_state.json"))
MAX_FAILS_BEFORE_ALERT = 6  # bei 5-Minuten-Takt = ca. 30 Minuten Dauerfehler

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/124.0 Safari/537.36"
    ),
    "Accept-Language": "de-DE,de;q=0.9,en;q=0.5",
    "Accept": "text/html,application/xhtml+xml",
}

NOT_AVAILABLE_RE = re.compile(
    r"nicht\s+verf(?:ü|ue|&uuml;|&#252;|\\u00fc)gbar", re.IGNORECASE
)
AVAILABILITY_RE = re.compile(r'"availability"\s*:\s*"([^"]+)"', re.IGNORECASE)


def current_url() -> str:
    return os.getenv("WATCH_URL", WATCH_URL_DEFAULT)


def current_state_file() -> Path:
    return Path(os.getenv("STATE_FILE", str(STATE_FILE_DEFAULT)))


def fetch(url: str) -> str:
    last_err = None
    for _ in range(3):
        try:
            r = requests.get(url, headers=HEADERS, timeout=20)
            if r.status_code != 200:
                raise RuntimeError(f"HTTP {r.status_code}")
            return r.text
        except Exception as e:  # noqa: BLE001
            last_err = e
    raise RuntimeError(f"Abruf fehlgeschlagen: {last_err}")


def analyze(html: str) -> dict:
    """Liest die Verfuegbarkeits-Signale aus dem HTML."""
    page_ok = "dream peaks" in html.lower()
    jsonld = sorted({m.group(1).split("/")[-1] for m in AVAILABILITY_RE.finditer(html)})
    n_unavail = len(NOT_AVAILABLE_RE.findall(html))
    has_cart_button = "in den warenkorb" in html.lower()

    jl = " ".join(jsonld).lower()
    if "instock" in jl or "limitedavailability" in jl or "preorder" in jl:
        status = "available"
    elif "outofstock" in jl or "soldout" in jl or "discontinued" in jl:
        status = "unavailable"
    elif n_unavail > 0:
        status = "unavailable"
    elif has_cart_button:
        status = "available"
    else:
        status = "unknown"

    return {
        "page_ok": page_ok,
        "status": status,
        "jsonld": jsonld,
        "n_unavail": n_unavail,
        "has_cart_button": has_cart_button,
        # Aendert sich irgendein Signal, wird gemeldet - auch wenn die
        # Statuslogik oben die Seite falsch deuten sollte.
        "signature": f"{','.join(jsonld)}|{n_unavail}|{int(has_cart_button)}",
    }


def load_state() -> dict:
    try:
        return json.loads(current_state_file().read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return {}


def save_state(state: dict) -> None:
    current_state_file().write_text(json.dumps(state), encoding="utf-8")


def notify(title: str, message: str, urgent: bool = False) -> bool:
    sent = False

    topic = os.getenv("NTFY_TOPIC")
    if topic:
        try:
            server = os.getenv("NTFY_SERVER", "https://ntfy.sh").rstrip("/")
            headers = {
                "Title": title,
                "Priority": "urgent" if urgent else "default",
                "Click": current_url(),
                "Tags": "christmas_tree",
            }

            username = os.getenv("NTFY_USERNAME")
            password = os.getenv("NTFY_PASSWORD")
            token = os.getenv("NTFY_TOKEN")
            if token:
                headers["Authorization"] = f"Bearer {token}"

            post_kwargs = {
                "data": message.encode("utf-8"),
                "headers": headers,
                "timeout": 15,
            }
            if username and password:
                post_kwargs["auth"] = (username, password)

            r = requests.post(f"{server}/{topic}", **post_kwargs)
            r.raise_for_status()
            sent = True
        except Exception as e:  # noqa: BLE001
            print(f"ntfy fehlgeschlagen: {e}", file=sys.stderr)

    host, to = os.getenv("SMTP_HOST"), os.getenv("MAIL_TO")
    if host and to:
        try:
            msg = EmailMessage()
            msg["Subject"] = title
            msg["From"] = os.getenv("MAIL_FROM") or os.getenv("SMTP_USER") or to
            msg["To"] = to
            msg.set_content(f"{message}\n\n{current_url()}")
            port = int(os.getenv("SMTP_PORT", "465"))
            with smtplib.SMTP_SSL(host, port, timeout=20) as s:
                if os.getenv("SMTP_USER"):
                    s.login(os.getenv("SMTP_USER"), os.getenv("SMTP_PASS", ""))
                s.send_message(msg)
            sent = True
        except Exception as e:  # noqa: BLE001
            print(f"E-Mail fehlgeschlagen: {e}", file=sys.stderr)

    if not sent:
        print("WARNUNG: Keine Benachrichtigung verschickt (Kanal fehlt/Fehler).", file=sys.stderr)
    return sent


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--debug", action="store_true")
    ap.add_argument("--test-notify", action="store_true")
    ap.add_argument("--watch-url", default=os.getenv("WATCH_URL", WATCH_URL_DEFAULT))
    ap.add_argument("--state-file", default=os.getenv("STATE_FILE", str(STATE_FILE_DEFAULT)))
    args = ap.parse_args()

    os.environ["WATCH_URL"] = args.watch_url
    os.environ["STATE_FILE"] = args.state_file
    globals()["WATCH_URL_DEFAULT"] = args.watch_url
    globals()["STATE_FILE_DEFAULT"] = Path(args.state_file)

    if args.test_notify:
        ok = notify("Legami-Waechter Test", "Benachrichtigung funktioniert.")
        return 0 if ok else 1

    state = load_state()

    try:
        html = fetch(current_url())
        info = analyze(html)
        if not info["page_ok"]:
            raise RuntimeError("Seite geladen, aber Produktinhalt fehlt (blockiert/geaendert?)")
    except Exception as e:  # noqa: BLE001
        fails = state.get("fails", 0) + 1
        state["fails"] = fails
        save_state(state)
        print(f"Fehler ({fails}x in Folge): {e}", file=sys.stderr)
        if fails == MAX_FAILS_BEFORE_ALERT:
            notify(
                "Legami-Waechter: Abruf klappt nicht",
                f"{fails} Fehlversuche in Folge: {e}. Die Seite blockiert evtl. den Abruf.",
            )
        return 0  # kein Fehlercode, damit Cron/Actions nicht Alarm schlagen

    if args.debug:
        print(json.dumps(info, indent=2, ensure_ascii=False))

    prev_sig = state.get("signature")
    prev_status = state.get("status")
    print(f"Status: {info['status']} (vorher: {prev_status}) | Signale: {info['signature']}")

    changed = prev_sig is not None and (
        info["signature"] != prev_sig or info["status"] != prev_status
    )
    first_and_available = prev_sig is None and info["status"] == "available"

    if first_and_available or (changed and info["status"] == "available"):
        notify(
            "Legami Adventskalender VERFUEGBAR",
            "Dream Peaks scheint jetzt bestellbar zu sein. Schnell pruefen!",
            urgent=True,
        )
    elif changed and info["status"] == "unavailable":
        notify("Legami Kalender: wieder ausverkauft", "Der Kalender ist wieder nicht verfuegbar.")
    elif changed:
        notify(
            "Legami-Seite hat sich geaendert",
            f"Status unklar ({info['status']}). Bitte manuell pruefen.",
        )

    state.update(signature=info["signature"], status=info["status"], fails=0)
    save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main())
